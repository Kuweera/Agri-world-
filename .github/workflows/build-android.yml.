name: Build Android APK

on:
  push:
    branches: [main]
  workflow_dispatch:

env:
  GODOT_VERSION: "4.3"

jobs:
  export-android:
    runs-on: ubuntu-22.04
    container:
      image: barichello/godot-ci:4.3
    steps:
      - uses: actions/checkout@v4

      - name: Set up templates, keystore and editor settings
        run: |
          mkdir -p ~/.local/share/godot/export_templates ~/.config/godot build/android
          mv /root/.local/share/godot/export_templates/${GODOT_VERSION}.stable ~/.local/share/godot/export_templates/${GODOT_VERSION}.stable
          keytool -keyalg RSA -genkeypair -alias androiddebugkey -keypass android \
            -keystore $HOME/debug.keystore -storepass android \
            -dname "CN=Android Debug,O=Android,C=US" -validity 9999 -deststoretype pkcs12
          JAVA_HOME_DIR=$(dirname $(dirname $(readlink -f $(which keytool))))
          echo "Java home: $JAVA_HOME_DIR"
          printf '%s\n' '[gd_resource type="EditorSettings" format=3]' '' '[resource]' \
            'export/android/android_sdk_path = "/usr/lib/android-sdk"' \
            "export/android/java_sdk_path = \"$JAVA_HOME_DIR\"" \
            "export/android/debug_keystore = \"$HOME/debug.keystore\"" \
            'export/android/debug_keystore_user = "androiddebugkey"' \
            'export/android/debug_keystore_pass = "android"' \
            > ~/.config/godot/editor_settings-4.tres

      - name: Import project
        run: godot --headless --import || true

      - name: Syntax check scripts
        continue-on-error: true
        run: |
          for f in farm_main farm_grid camera_rig hud game_state crop_data save_manager; do
            echo "== $f"
            godot --headless --check-only --script res://scripts/$f.gd || echo "SYNTAX FAIL: $f"
          done

      - name: Run logic tests
        continue-on-error: true
        run: godot --headless --script res://scripts/tests/test_game_state.gd

      - name: Export diagnostic APKs
        run: |
          for v in main diag_all_env; do
            sed -i "s|^run/main_scene=.*|run/main_scene=\"res://scenes/$v.tscn\"|" project.godot
            grep main_scene project.godot
            godot --headless --verbose --export-debug "Android" build/android/agriworld-$v.apk
          done

      - uses: actions/upload-artifact@v4
        with:
          name: agriworld-debug-apks
          path: build/android/*.apk
